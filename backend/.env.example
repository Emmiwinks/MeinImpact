MEINIMPACT_ENVIRONMENT=local
MEINIMPACT_DATABASE_URL=postgresql+asyncpg://meinimpact:meinimpact@db:5432/meinimpact
MEINIMPACT_JWT_SECRET=replace-this-local-development-secret
MEINIMPACT_JWT_ISSUER=meinimpact-api
MEINIMPACT_JWT_AUDIENCE=meinimpact-app
MEINIMPACT_MISTRAL_API_KEY=
MEINIMPACT_MISTRAL_MODEL=mistral-small-latest
MEINIMPACT_ADMIN_PASSWORD=
# Leave off locally so ingestion never spends Mistral credit by itself.
# MEINIMPACT_INGESTION_SCHEDULER_ENABLED=true
